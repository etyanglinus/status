{
  "name": "fasta-status",
  "version": "1.0.0",
  "private": true,
  "description": "Fasta Status: public service status page, changelog and roadmap on Cloudflare Workers + D1 (free plan).",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fasta-status --local",
    "db:migrate:remote": "wrangler d1 migrations apply fasta-status --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
